# Copy to .env.local and fill in. Never commit real values.

# Anthropic (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (Project settings → API). Service-role key is SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Max AI reports per user per rolling 24h (cost control)
DAILY_REPORT_LIMIT=15

# No key is needed for the World Bank Open Data API.
